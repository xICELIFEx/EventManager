<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13"/>
        <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
    </ItemGroup>

    <Target Name="GenerateDocs" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
        <Exec Command="swagger tofile --output ../swagger.json $(OutputPath)$(AssemblyName).dll v1" />
        <Exec Command="widdershins ../swagger.json -o ../API_DOCS.md --omitHeader --language_tabs 'shell:Curl' 'http:HTTP'" />
    </Target>

</Project>
